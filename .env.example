# Supabase — get from your project dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only — NEVER expose to browser
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ──────────────────────────────────────────────────────────────────
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_

# Webhook secret — from Stripe dashboard → Webhooks → your endpoint
# For local dev: stripe listen --forward-to localhost:3000/api/stripe/webhooks
STRIPE_WEBHOOK_SECRET=whsec_

# Your price IDs from Stripe dashboard → Products
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY=price_
NEXT_PUBLIC_STRIPE_PRICE_YEARLY=price_

# Enterprise "deep scan" upsell price in cents (default 49900 = $499).
# Uses inline price_data, so only STRIPE_SECRET_KEY is required to go live.
DEEP_SCAN_PRICE_CENTS=49900

# ── Stripe Connect (set by Vibe Launchpad when provisioned via platform) ────
# Leave blank if running standalone with your own Stripe account
STRIPE_CONNECT_ACCOUNT_ID=
STRIPE_PLATFORM_FEE_PERCENT=

# ── App URL (used for redirect URLs) ────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Real outbound is gated on this key: when unset, all sends no-op and are only
# logged (dev). When set (Vercel prod), operator alerts + command-center emails
# actually deliver. From-addresses use the Resend-verified thesoulsofai.com domain
# (alerts@ / no-reply@ / reports@) — never a gmail sender.
RESEND_API_KEY=

# Command-center admin allowlist (comma-separated). The FIRST entry also receives
# the new-scan-request operator alert; falls back to thesoulsofai@gmail.com if empty.
ADMIN_EMAILS=
